{
  "$id": "https://www.codesys.com/c4/schemas/Libraries.lock.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resolved library lock file",
  "description": "The resolved result of Libraries.json: the exact libraries, sources and versions the build uses, pinned for reproducibility. This file is generated by the tooling; if it is wrong or stale, fix Libraries.json and rebuild, or resolve all it to have it regenerated.",
  "unevaluatedProperties": false,
  "type": "object",
  "properties": {
    "resolutions": {
      "type": "object",
      "title": "Resolutions",
      "description": "The resolved entries, keyed by the resolved object. Each entry's '$type' selects its shape.",
      "additionalProperties": {
        "allOf": [
          {
            "properties": {
              "$type": {
                "type": "string",
                "title": "Entry kind",
                "description": "The kind of resolved object: an application, a device, a source library project (or its root/file), a compiled library, or a system entry.",
                "enum": [
                  "Application",
                  "CompiledLibrary",
                  "Device",
                  "LibraryProject",
                  "LibraryProjectFile",
                  "LibraryProjectRoot",
                  "System"
                ]
              }
            },
            "required": [
              "$type"
            ]
          },
          {
            "if": {
              "properties": {
                "$type": {
                  "const": "LibraryProject"
                }
              },
              "required": [
                "$type"
              ]
            },
            "then": {
              "type": "object",
              "properties": {
                "$type": {
                  "const": "LibraryProject"
                },
                "path": {
                  "type": "string"
                },
                "allowUnqualifiedAccessByLibrary": {
                  "type": "boolean",
                  "default": false
                },
                "libraryParameters": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "references": {
                  "$ref": "#/$defs/references"
                }
              },
              "required": [
                "$type",
                "path",
                "references"
              ],
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "$type": {
                  "const": "CompiledLibrary"
                }
              },
              "required": [
                "$type"
              ]
            },
            "then": {
              "$ref": "#/$defs/libraryFiles"
            }
          },
          {
            "if": {
              "properties": {
                "$type": {
                  "const": "LibraryProjectFile"
                }
              },
              "required": [
                "$type"
              ]
            },
            "then": {
              "$ref": "#/$defs/libraryFiles"
            }
          },
          {
            "if": {
              "properties": {
                "$type": {
                  "const": "Application"
                }
              },
              "required": [
                "$type"
              ]
            },
            "then": {
              "$ref": "#/$defs/topLevel"
            }
          },
          {
            "if": {
              "properties": {
                "$type": {
                  "const": "Device"
                }
              },
              "required": [
                "$type"
              ]
            },
            "then": {
              "$ref": "#/$defs/topLevel"
            }
          },
          {
            "if": {
              "properties": {
                "$type": {
                  "const": "System"
                }
              },
              "required": [
                "$type"
              ]
            },
            "then": {
              "$ref": "#/$defs/topLevel"
            }
          },
          {
            "if": {
              "properties": {
                "$type": {
                  "const": "LibraryProjectRoot"
                }
              },
              "required": [
                "$type"
              ]
            },
            "then": {
              "$ref": "#/$defs/topLevel"
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "references": {
      "type": "object",
      "title": "References",
      "description": "The resolved library references of an entry, keyed by reference name. Each reference lists the sources it was resolved from.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sources": {
            "$ref": "#/$defs/sources"
          },
          "isContainer": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "object",
      "title": "Sources",
      "description": "The candidate sources a reference resolved from, keyed by source key. Each source's '$type' matches the reference kinds in Libraries.json (RelativePath, ManagedLibrary or Placeholder).",
      "additionalProperties": {
        "allOf": [
          {
            "properties": {
              "$type": {
                "type": "string",
                "enum": [
                  "RelativePath",
                  "ManagedLibrary",
                  "Placeholder"
                ]
              }
            },
            "required": [
              "$type"
            ]
          },
          {
            "if": {
              "properties": {
                "$type": {
                  "const": "RelativePath"
                }
              },
              "required": [
                "$type"
              ]
            },
            "then": {
              "type": "object",
              "properties": {
                "$type": {
                  "const": "RelativePath"
                },
                "allowUnqualifiedAccess": {
                  "type": "boolean",
                  "default": false
                },
                "publishSymbolsInContainer": {
                  "type": "boolean",
                  "default": false
                },
                "linkAllContent": {
                  "type": "boolean",
                  "default": false
                },
                "optional": {
                  "type": "boolean",
                  "default": false
                },
                "warnIfMissing": {
                  "type": "boolean",
                  "default": false
                },
                "path": {
                  "type": "string"
                },
                "noHash": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "$type",
                "path"
              ],
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "$type": {
                  "const": "ManagedLibrary"
                }
              },
              "required": [
                "$type"
              ]
            },
            "then": {
              "type": "object",
              "properties": {
                "$type": {
                  "const": "ManagedLibrary"
                },
                "allowUnqualifiedAccess": {
                  "type": "boolean",
                  "default": false
                },
                "publishSymbolsInContainer": {
                  "type": "boolean",
                  "default": false
                },
                "linkAllContent": {
                  "type": "boolean",
                  "default": false
                },
                "optional": {
                  "type": "boolean",
                  "default": false
                },
                "warnIfMissing": {
                  "type": "boolean",
                  "default": false
                },
                "libraryId": {
                  "type": "string"
                },
                "includePrerelease": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "$type",
                "libraryId"
              ],
              "additionalProperties": false
            }
          },
          {
            "if": {
              "properties": {
                "$type": {
                  "const": "Placeholder"
                }
              },
              "required": [
                "$type"
              ]
            },
            "then": {
              "type": "object",
              "properties": {
                "$type": {
                  "const": "Placeholder"
                },
                "allowUnqualifiedAccess": {
                  "type": "boolean",
                  "default": false
                },
                "publishSymbolsInContainer": {
                  "type": "boolean",
                  "default": false
                },
                "linkAllContent": {
                  "type": "boolean",
                  "default": false
                },
                "optional": {
                  "type": "boolean",
                  "default": false
                },
                "warnIfMissing": {
                  "type": "boolean",
                  "default": false
                },
                "placeholder": {
                  "type": "string"
                },
                "defaultResolution": {
                  "type": "string",
                  "default": null
                },
                "resolverGuid": {
                  "type": "string",
                  "default": "00000000-0000-0000-0000-000000000000",
                  "description": "A workaround for placeholder resolution. Currently in the Library Agenda (https://confluence.codesys.com/x/YAIGDg) and will in the future either be added to the FS or removed"
                },
                "includePrerelease": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "$type",
                "placeholder"
              ],
              "additionalProperties": false
            }
          }
        ]
      }
    },
    "libraryFiles": {
      "type": "object",
      "title": "Library file",
      "description": "A resolved library that is a file on disk (a compiled library or a library project file), with its path, hash and references.",
      "properties": {
        "$type": {
          "type": "string",
          "enum": [
            "CompiledLibrary",
            "LibraryProjectFile"
          ]
        },
        "path": {
          "type": "string"
        },
        "sha384": {
          "type": "string",
          "default": null
        },
        "allowUnqualifiedAccessByLibrary": {
          "type": "boolean",
          "default": false
        },
        "libraryParameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "references": {
          "$ref": "#/$defs/references"
        }
      },
      "required": [
        "$type",
        "path",
        "references"
      ],
      "additionalProperties": false
    },
    "topLevel": {
      "type": "object",
      "title": "Top-level entry",
      "description": "A resolved top-level object (application, device, library project root or system) and the references it owns.",
      "properties": {
        "$type": {
          "type": "string",
          "enum": [
            "Application",
            "Device",
            "LibraryProjectRoot",
            "System"
          ]
        },
        "path": {
          "type": "string",
          "description": "Workaround until the plc dev desc is moved into the device cache with GO-1013, then this property will be removed"
        },
        "references": {
          "$ref": "#/$defs/references"
        }
      },
      "required": [
        "$type",
        "references"
      ],
      "additionalProperties": false
    }
  }
}