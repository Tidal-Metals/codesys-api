          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM PLC_PRG
VAR
    Poller : FB_ModbusTenUnits;
    AllTenValuesMatch : BOOL;
    i : INT;
END_VAR
</Single>
